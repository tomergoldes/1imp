# ─────────────────────────────────────────────────────────────
# 1IMP — Environment Variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Public base URL of the deployment (used for share links, OG images, webhooks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Postgres) ──────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Direct (non-pooled) connection string used by Prisma migrations.
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── Auth (NextAuth v4) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Google OAuth (optional — credentials login works without it).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin seed (scripts/seed-admin.ts) ───────────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""            # min 12 chars
ADMIN_NAME="Admin"
# Set to "true" to reset an existing admin's password when re-seeding.
ADMIN_RESET_PASSWORD="false"

# ── AI: OpenAI (script/story engines) ────────────────────────
OPENAI_API_KEY=""

# ── AI: ElevenLabs (voice-over) ──────────────────────────────
ELEVENLABS_API_KEY=""

# ── AI: fal.ai (ninja avatar + AI scene video) ───────────────
# NOTE: the fal.ai integration is currently a stub (not implemented).
# Set ENABLE_AI_SCENE_GENERATION="true" only once fal-client.ts is implemented.
FAL_KEY=""
ENABLE_AI_SCENE_GENERATION="false"

# ── Video rendering: Shotstack (composition) ─────────────────
SHOTSTACK_API_KEY=""
# Shared secret appended to the Shotstack callback URL and verified by the
# webhook. Generate with: openssl rand -hex 32
SHOTSTACK_WEBHOOK_SECRET=""

# ── Payments: Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Storage: Supabase (voice-over/audio uploads) ─────────────
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Fallback anon key (only used if the service-role key is absent).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Email: Resend (transactional emails) ─────────────────────
RESEND_API_KEY=""
